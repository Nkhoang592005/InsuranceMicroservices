{
  "version": "2.0.0",
  "tasks": [
    {
      "label": ".NET: build solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "InsuranceMicroservices.slnx", "--tl:on", "-m:1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "PostgreSQL: verify demo data",
      "type": "process",
      "command": "D:\\postgresql-16.15-5-windows-x64-binaries\\pgsql\\bin\\psql.exe",
      "args": [
        "-h", "127.0.0.1", "-p", "5434", "-U", "postgres", "-w",
        "-d", "lab_netmicro_demo", "-v", "ON_ERROR_STOP=1",
        "-f", "scripts/scripts/verify-demo.sql"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
